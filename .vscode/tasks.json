{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: build produk.exe",
            "command": "c:\\Program Files (x86)\\Dev-Cpp\\MinGW64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++11",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-I${workspaceFolder}\\include",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\file_io.cpp",
                "${workspaceFolder}\\src\\fitur.cpp",
                "-o",
                "${workspaceFolder}\\produk.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build all project source files."
        }
    ],
    "version": "2.0.0"
}